---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { render } from 'astro:content';
import {
  formatDate,
  getAdjacentPosts,
  getBlogPath,
  getBlogPostPath,
  getLocaleFromId,
  getPostLanguageLinks,
  getReadingTime,
  getRssPath,
  getSlugFromId,
  getTagPath,
  getTranslations,
  type BlogPost,
  type Locale,
} from '../utils/blog';

interface Props {
  post: BlogPost;
  lang: Locale;
  t: Record<string, any>;
  allPosts: BlogPost[];
}

const { post, lang, t, allPosts } = Astro.props;

const slug = getSlugFromId(post.id);
const url = getBlogPostPath(lang, slug);
const { Content, headings } = await render(post);
const readingTime = getReadingTime(post.body);
const translations = getTranslations(post, allPosts);
const langLinks = getPostLanguageLinks(post, allPosts);
const postsByLocale = allPosts.filter((candidate) => getLocaleFromId(candidate.id) === lang);
const { older, newer } = getAdjacentPosts(post, postsByLocale);
const tags = post.data.tags ?? [];

const languageNames: Record<Locale, string> = {
  en: 'English',
  es: 'Español',
  pt: 'Português',
};

const otherTranslations = (Object.entries(translations) as Array<[Locale, BlogPost]>)
  .filter(([locale]) => locale !== lang);

const alternates: Array<{ hreflang: string; href: string }> = (
  Object.entries(translations) as Array<[Locale, BlogPost]>
).map(([locale, translation]) => ({
  hreflang: locale,
  href: getBlogPostPath(locale, getSlugFromId(translation.id)),
}));

if (translations.en) {
  alternates.push({
    hreflang: 'x-default',
    href: getBlogPostPath('en', getSlugFromId(translations.en.id)),
  });
}

const image = post.data.cover ?? '/og-image.png';
const imageUrl = new URL(image, Astro.site ?? 'https://cargabsj175.github.io').toString();
const published = post.data.pubDate.toISOString();
const modified = (post.data.updatedDate ?? post.data.pubDate).toISOString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  image: [imageUrl],
  datePublished: published,
  dateModified: modified,
  inLanguage: lang,
  author: { '@type': 'Person', name: post.data.author },
  mainEntityOfPage: new URL(url, Astro.site ?? 'https://cargabsj175.github.io').toString(),
  keywords: tags.join(', '),
};
---

<BaseLayout
  title={`${post.data.title} | Blog`}
  description={post.data.description}
  lang={lang}
  type="article"
  image={image}
  rssUrl={getRssPath(lang)}
  alternates={alternates}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <Header t={t} currentLang={lang} variant="solid" langLinks={langLinks} />

  <main class="bg-light py-10 md:py-14">
    <article class="container mx-auto max-w-5xl px-4">
      <a href={getBlogPath(lang)} class="mb-8 inline-flex items-center gap-2 text-sm font-medium text-primary hover:text-primary-dark">
        {t.blog.backToBlog}
      </a>

      <header class="max-w-3xl">
        <h1 class="text-3xl font-bold leading-tight text-dark md:text-4xl lg:text-5xl">{post.data.title}</h1>

        <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-gray-500">
          <time datetime={published}>{formatDate(post.data.pubDate, lang)}</time>
          <span aria-hidden="true">·</span>
          <span>{readingTime} {t.blog.readingTime}</span>
          <span aria-hidden="true">·</span>
          <span>{t.blog.by} {post.data.author}</span>
        </div>

        {post.data.updatedDate && (
          <p class="mt-2 text-sm text-gray-500">
            {t.blog.updatedOn} <time datetime={modified}>{formatDate(post.data.updatedDate, lang)}</time>
          </p>
        )}

        {tags.length > 0 && (
          <div class="mt-5 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <a
                href={getTagPath(lang, tag)}
                class="rounded-full bg-white px-3 py-1 text-xs font-medium text-gray-600 ring-1 ring-gray-200 transition hover:bg-primary hover:text-white hover:ring-primary"
              >
                #{tag}
              </a>
            ))}
          </div>
        )}
      </header>

      {post.data.cover && (
        <img
          src={post.data.cover}
          alt={post.data.coverAlt ?? post.data.title}
          class="mt-8 max-h-[32rem] w-full rounded-xl object-cover"
        />
      )}

      <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_16rem]">
        <div class="min-w-0">
          <div class="lg:hidden">
            <TableOfContents headings={headings} label={t.blog.toc} />
          </div>

          <div class="prose prose-lg mt-6 max-w-none lg:mt-0">
            <Content />
          </div>

          {otherTranslations.length > 0 && (
            <aside class="mt-10 rounded-xl border border-gray-200 bg-white p-5 text-sm text-gray-600">
              <p class="font-medium text-dark">{t.blog.availableIn}:</p>
              <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
                {otherTranslations.map(([locale, translation]) => (
                  <li>
                    <a
                      href={getBlogPostPath(locale, getSlugFromId(translation.id))}
                      hreflang={locale}
                      class="font-medium text-primary hover:underline"
                    >
                      {languageNames[locale]}
                    </a>
                  </li>
                ))}
              </ul>
            </aside>
          )}
        </div>

        <aside class="hidden lg:block">
          <div class="sticky top-24">
            <TableOfContents headings={headings} label={t.blog.toc} />
          </div>
        </aside>
      </div>

      {(older || newer) && (
        <nav class="mt-12 grid gap-4 border-t border-gray-200 pt-8 sm:grid-cols-2" aria-label="Article navigation">
          {older ? (
            <a href={getBlogPostPath(lang, getSlugFromId(older.id))} class="rounded-xl border border-gray-200 bg-white p-5 transition hover:border-primary/40 hover:shadow-sm">
              <span class="text-xs font-semibold uppercase tracking-wide text-gray-500">{t.blog.previous}</span>
              <span class="mt-1 block font-semibold text-dark">{older.data.title}</span>
            </a>
          ) : (
            <span></span>
          )}
          {newer && (
            <a href={getBlogPostPath(lang, getSlugFromId(newer.id))} class="rounded-xl border border-gray-200 bg-white p-5 text-left transition hover:border-primary/40 hover:shadow-sm sm:text-right">
              <span class="text-xs font-semibold uppercase tracking-wide text-gray-500">{t.blog.next}</span>
              <span class="mt-1 block font-semibold text-dark">{newer.data.title}</span>
            </a>
          )}
        </nav>
      )}
    </article>
  </main>

  <Footer t={t} />
</BaseLayout>
