---
interface Props {
  t: Record<string, any>;
  currentLang: string;
  variant?: 'overlay' | 'solid';
  langLinks?: Record<string, string>;
}

const { t, currentLang, variant = 'overlay', langLinks } = Astro.props;

const home = currentLang === 'en' ? '/' : `/${currentLang}/`;
const blogPath = currentLang === 'en' ? '/blog/' : `/${currentLang}/blog/`;

const languages = [
  { code: 'en', label: 'EN', name: 'English' },
  { code: 'es', label: 'ES', name: 'Español' },
  { code: 'pt', label: 'PT', name: 'Português' },
];

const getLangHref = (code: string) =>
  langLinks?.[code] ?? (code === 'en' ? '/' : `/${code}/`);

const headerClass =
  variant === 'solid'
    ? 'sticky top-0 w-full z-50 bg-white text-dark shadow-sm'
    : 'fixed w-full top-0 left-0 z-50 transition-all duration-300 bg-transparent text-white';

const mobileMenuClass =
  variant === 'solid'
    ? 'hidden md:hidden bg-white/95 backdrop-blur-sm border-t border-gray-200'
    : 'hidden md:hidden bg-dark/95 backdrop-blur-sm';

const navItems = [
  { href: `${home}#about`, label: t.nav.about },
  { href: `${home}#experience`, label: t.nav.experience },
  { href: `${home}#skills`, label: t.nav.skills },
  { href: `${home}#services`, label: t.nav.services },
  { href: `${home}#projects`, label: t.nav.projects },
  { href: blogPath, label: t.nav.blog },
  { href: `${home}#contact`, label: t.nav.contact },
];
---

<header id="header" class={headerClass}>
  <nav class="container mx-auto px-4 py-4 flex justify-between items-center">
    <a href={home} class="text-xl font-bold">Carlos Sánchez</a>

    <div class="hidden md:flex items-center gap-6">
      {navItems.map((item) => (
        <a href={item.href} class="hover:text-secondary transition-colors">{item.label}</a>
      ))}

      <div class={`flex gap-2 ml-4 border-l pl-4 ${variant === 'solid' ? 'border-gray-300' : 'border-white/30'}`}>
        {languages.map((lang) => (
          <a
            href={getLangHref(lang.code)}
            class={`px-2 py-1 rounded text-sm font-medium transition-colors ${
              lang.code === currentLang
                ? 'bg-secondary text-white'
                : variant === 'solid'
                  ? 'hover:bg-gray-200'
                  : 'hover:bg-white/20'
            }`}
            title={lang.name}
            hreflang={lang.code}
          >
            {lang.label}
          </a>
        ))}
      </div>
    </div>

    <button id="menu-toggle" class="md:hidden text-2xl" aria-label="Toggle menu" aria-expanded="false">
      <i class="fas fa-bars"></i>
    </button>
  </nav>

  <div id="mobile-menu" class={mobileMenuClass}>
    <ul class="flex flex-col items-center py-4 gap-4">
      {navItems.map((item) => (
        <li><a href={item.href} class="hover:text-secondary transition-colors">{item.label}</a></li>
      ))}
      <li class={`flex gap-2 pt-2 border-t w-full justify-center ${variant === 'solid' ? 'border-gray-300' : 'border-white/30'}`}>
        {languages.map((lang) => (
          <a
            href={getLangHref(lang.code)}
            class={`px-3 py-1 rounded text-sm font-medium transition-colors ${
              lang.code === currentLang
                ? 'bg-secondary text-white'
                : variant === 'solid'
                  ? 'hover:bg-gray-200'
                  : 'hover:bg-white/20'
            }`}
            hreflang={lang.code}
          >
            {lang.label}
          </a>
        ))}
      </li>
    </ul>
  </div>
</header>

<script define:vars={{ variant }}>
  const header = document.getElementById('header');
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  if (variant === 'overlay' && header) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 50) {
        header.classList.add('bg-white', 'text-dark', 'shadow-md');
        header.classList.remove('bg-transparent', 'text-white');
      } else {
        header.classList.remove('bg-white', 'text-dark', 'shadow-md');
        header.classList.add('bg-transparent', 'text-white');
      }
    });
  }

  menuToggle?.addEventListener('click', () => {
    const isHidden = mobileMenu?.classList.toggle('hidden');
    menuToggle.setAttribute('aria-expanded', String(!isHidden));
  });

  document.querySelectorAll('#mobile-menu a').forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.add('hidden');
      menuToggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
