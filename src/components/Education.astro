---
interface Props {
  t: Record<string, any>;
}

const { t } = Astro.props;
---

<section id="education" class="py-16 bg-white">
  <div class="container mx-auto px-4">
    <h2 class="text-3xl md:text-4xl font-bold mb-12 text-center text-dark">{t.education.title}</h2>
    
    <div class="max-w-3xl mx-auto grid md:grid-cols-2 gap-8">
      {t.education.items.map((item: { institution: string; degree: string; period: string }) => (
        <div class="bg-gray-50 p-6 rounded-lg shadow-md hover:shadow-lg transition-shadow">
          <h3 class="text-xl font-semibold text-dark mb-2">{item.institution}</h3>
          <p class="text-primary font-medium mb-2">{item.degree}</p>
          <span class="text-gray-500 text-sm bg-gray-200 px-3 py-1 rounded-full">{item.period}</span>
        </div>
      ))}
    </div>
  </div>
</section>
