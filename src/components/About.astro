---
interface Props {
  t: Record<string, any>;
  currentLang?: string;
}

const { t, currentLang = 'en' } = Astro.props;
---

<section id="about" class="py-16 bg-white">
  <div class="container mx-auto px-4">
    <div class="flex flex-col lg:flex-row items-center gap-12">
      <div class="lg:w-1/2">
        <h2 class="text-3xl md:text-4xl font-bold mb-6 text-dark">{t.about.title}</h2>
        <p class="text-gray-600 leading-relaxed mb-6">{t.about.bio}</p>
        
        <button id="download-cv-btn" class="bg-primary hover:bg-primary-dark text-white px-6 py-3 rounded-lg font-medium transition-colors flex items-center gap-2">
          <i class="fas fa-download"></i>
          {t.about.downloadCV} ({currentLang.toUpperCase()})
        </button>
      </div>
      
      <div class="lg:w-1/2">
        <img src="/about.webp" alt={t.about.title} class="w-full max-w-lg mx-auto rounded-lg shadow-lg" />
      </div>
    </div>
  </div>
</section>

<script>
  import { jsPDF } from 'jspdf';
  import 'jspdf-autotable';

  interface CVData {
    name: string;
    title: string;
    email: string;
    phone1: string;
    phone2: string;
    location: string;
    website: string;
    profile: string;
    experience: Array<{ company: string; period: string; role: string; description: string }>;
    education: Array<{ institution: string; degree: string; period: string }>;
    skills: { name: string; items: string[] }[];
    languages: Array<{ name: string; level: string }>;
  }

  function generateCV(data: CVData, lang: string): void {
    const doc = new jsPDF();
    const pageWidth = doc.internal.pageSize.getWidth();
    const margin = 20;
    const contentWidth = pageWidth - margin * 2;
    let y = 20;

    doc.setFont('helvetica');

    // Header
    doc.setFontSize(22);
    doc.setTextColor(37, 99, 235);
    doc.text(data.name, margin, y);
    y += 8;

    doc.setFontSize(14);
    doc.setTextColor(16, 185, 129);
    doc.text(data.title, margin, y);
    y += 10;

    // Contact info
    doc.setFontSize(9);
    doc.setTextColor(100, 100, 100);
    const contactLine = `${data.email}  |  ${data.phone1}  |  ${data.location}`;
    doc.text(contactLine, margin, y);
    y += 5;
    doc.text(data.website, margin, y);
    y += 10;

    // Divider
    doc.setDrawColor(37, 99, 235);
    doc.setLineWidth(0.5);
    doc.line(margin, y, pageWidth - margin, y);
    y += 8;

    // Profile
    doc.setFontSize(12);
    doc.setTextColor(37, 99, 235);
    doc.text('PROFILE', margin, y);
    y += 6;

    doc.setFontSize(9);
    doc.setTextColor(60, 60, 60);
    const profileLines = doc.splitTextToSize(data.profile, contentWidth);
    doc.text(profileLines, margin, y);
    y += profileLines.length * 4.5 + 6;

    // Experience
    if (y > 240) { doc.addPage(); y = 20; }
    doc.setFontSize(12);
    doc.setTextColor(37, 99, 235);
    doc.text('WORK EXPERIENCE', margin, y);
    y += 6;

    for (const job of data.experience) {
      if (y > 250) { doc.addPage(); y = 20; }

      doc.setFontSize(10);
      doc.setTextColor(30, 30, 30);
      doc.text(job.company, margin, y);
      y += 5;

      doc.setFontSize(9);
      doc.setTextColor(16, 185, 129);
      doc.text(job.role, margin, y);
      y += 5;

      doc.setTextColor(100, 100, 100);
      doc.text(job.period, margin, y);
      y += 5;

      doc.setTextColor(60, 60, 60);
      const descLines = doc.splitTextToSize(job.description, contentWidth);
      doc.text(descLines, margin, y);
      y += descLines.length * 4.5 + 4;
    }

    // Education
    y += 2;
    if (y > 240) { doc.addPage(); y = 20; }
    doc.setFontSize(12);
    doc.setTextColor(37, 99, 235);
    doc.text('EDUCATION', margin, y);
    y += 6;

    for (const edu of data.education) {
      if (y > 260) { doc.addPage(); y = 20; }

      doc.setFontSize(10);
      doc.setTextColor(30, 30, 30);
      doc.text(edu.institution, margin, y);
      y += 5;

      doc.setFontSize(9);
      doc.setTextColor(16, 185, 129);
      doc.text(edu.degree, margin, y);
      y += 5;

      doc.setTextColor(100, 100, 100);
      doc.text(edu.period, margin, y);
      y += 8;
    }

    // Skills
    if (y > 230) { doc.addPage(); y = 20; }
    doc.setFontSize(12);
    doc.setTextColor(37, 99, 235);
    doc.text('SKILLS', margin, y);
    y += 6;

    for (const category of data.skills) {
      if (y > 260) { doc.addPage(); y = 20; }

      doc.setFontSize(10);
      doc.setTextColor(30, 30, 30);
      doc.text(category.name, margin, y);
      y += 5;

      doc.setFontSize(9);
      doc.setTextColor(60, 60, 60);
      const skillsText = category.items.join(', ');
      const skillLines = doc.splitTextToSize(skillsText, contentWidth);
      doc.text(skillLines, margin, y);
      y += skillLines.length * 4.5 + 3;
    }

    // Languages
    y += 2;
    if (y > 250) { doc.addPage(); y = 20; }
    doc.setFontSize(12);
    doc.setTextColor(37, 99, 235);
    doc.text('LANGUAGES', margin, y);
    y += 6;

    for (const l of data.languages) {
      if (y > 270) { doc.addPage(); y = 20; }

      doc.setFontSize(10);
      doc.setTextColor(30, 30, 30);
      doc.text(l.name, margin, y);

      doc.setTextColor(100, 100, 100);
      doc.text(l.level, margin + 60, y);
      y += 6;
    }

    doc.save(`Carlos_Sanchez_CV_${lang}.pdf`);
  }

