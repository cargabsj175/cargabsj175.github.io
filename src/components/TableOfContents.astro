---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  label: string;
}

const { headings, label } = Astro.props;
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{items.length > 1 && (
  <nav aria-label={label} class="rounded-xl border border-gray-200 bg-white p-5">
    <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-gray-500">{label}</p>
    <ul class="space-y-2 text-sm">
      {items.map((heading) => (
        <li class:list={[heading.depth === 3 && 'pl-4']}>
          <a href={`#${heading.slug}`} class="text-gray-600 transition hover:text-primary">
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
