---
interface Props {
  t: Record<string, any>;
}

const { t } = Astro.props;
---

<section id="services" class="py-16 bg-white">
  <div class="container mx-auto px-4">
    <h2 class="text-3xl md:text-4xl font-bold mb-12 text-center text-dark">{t.services.title}</h2>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
      {t.services.items.map((item: { icon: string; text: string }) => (
        <div class="bg-gray-50 p-6 rounded-lg shadow-md hover:shadow-lg hover:-translate-y-1 transition-all">
          <div class="text-4xl text-primary mb-4">
            <i class={`fas fa-${item.icon}`}></i>
          </div>
          <p class="text-gray-600 mb-4">{item.text}</p>
          <a href="#contact" class="inline-block bg-secondary hover:bg-secondary-dark text-white px-4 py-2 rounded text-sm font-medium transition-colors">
            {t.services.more}
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
