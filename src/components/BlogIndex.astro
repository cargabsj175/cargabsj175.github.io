---
import BlogCard from './BlogCard.astro';
import {
  getBlogPath,
  getPostsOnlyInOtherLocales,
  getRssPath,
  type BlogPost,
  type Locale,
} from '../utils/blog';

interface Props {
  lang: Locale;
  t: Record<string, any>;
  posts: BlogPost[];
  allPosts: BlogPost[];
}

const { lang, t, posts, allPosts } = Astro.props;

const rssPath = getRssPath(lang);
const onlyInOther = getPostsOnlyInOtherLocales(lang, allPosts);
const languageNames: Record<Locale, string> = {
  en: 'English',
  es: 'Español',
  pt: 'Português',
};

const resultsLabel = (count: number) =>
  `${count} ${count === 1 ? t.blog.resultOne : t.blog.resultOther}`;
---

<section class="bg-light py-12 md:py-16">
  <div class="container mx-auto max-w-5xl px-4">
    <header class="mb-8">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h1 class="text-3xl font-bold text-dark md:text-4xl">{t.blog.title}</h1>
          <p class="mt-3 max-w-2xl text-gray-600">{t.blog.subtitle}</p>
        </div>
        <a
          href={rssPath}
          class="inline-flex items-center gap-2 rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm font-medium text-gray-600 transition hover:border-primary/40 hover:text-primary"
          title={t.blog.rss}
        >
          <i class="fas fa-rss" aria-hidden="true"></i>
          {t.blog.rss}
        </a>
      </div>
    </header>

    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <form id="blog-search-form" class="relative w-full sm:max-w-md" role="search">
        <label for="blog-search" class="sr-only">{t.blog.searchPlaceholder}</label>
        <i class="fas fa-search pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-gray-400" aria-hidden="true"></i>
        <input
          id="blog-search"
          type="search"
          placeholder={t.blog.searchPlaceholder}
          autocomplete="off"
          class="w-full rounded-lg border border-gray-200 bg-white py-2.5 pl-10 pr-4 text-sm text-dark outline-none transition focus:border-primary focus:ring-2 focus:ring-primary/20"
        />
      </form>

      <p id="search-count" class="text-sm text-gray-500" aria-live="polite">
        {resultsLabel(posts.length)}
      </p>
    </div>

    <div id="tag-filter" class="mt-4 hidden items-center gap-2 text-sm text-gray-600">
      <span>{t.blog.filterByTag}: <strong id="tag-filter-name" class="text-dark"></strong></span>
      <button
        id="tag-filter-clear"
        type="button"
        class="rounded-md border border-gray-200 bg-white px-2 py-1 text-xs font-medium text-gray-600 transition hover:border-primary/40 hover:text-primary"
      >
        {t.blog.clearFilter}
      </button>
    </div>

    {posts.length === 0 && (
      <p class="mt-10 rounded-xl border border-dashed border-gray-300 bg-white p-8 text-center text-gray-500">
        {t.blog.noPosts}
      </p>
    )}

    <div id="blog-posts" class="mt-8 grid gap-6 md:grid-cols-2">
      {posts.map((post, index) => {
        const isFeatured = index === 0 && posts.length > 1 && Boolean(post.data.cover);
        return (
          <div data-blog-item class:list={[isFeatured && 'md:col-span-2']}>
            <BlogCard post={post} lang={lang} t={t} featured={isFeatured} />
          </div>
        );
      })}
    </div>

    <p id="search-empty" class="mt-10 hidden rounded-xl border border-dashed border-gray-300 bg-white p-8 text-center text-gray-500">
      {t.blog.searchNoResults}
    </p>

    {onlyInOther.length > 0 && (
      <aside class="mt-12 rounded-xl border border-gray-200 bg-white p-5 text-sm text-gray-600">
        <p class="font-medium text-dark">{t.blog.onlyInOther}</p>
        <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
          {onlyInOther.map(({ locale, posts: otherPosts }) => (
            <li>
              <a href={getBlogPath(locale)} class="font-medium text-primary hover:underline">
                {languageNames[locale]} ({otherPosts.length})
              </a>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </div>
</section>

<script
  define:vars={{
    locale: lang,
    resultOne: t.blog.resultOne,
    resultOther: t.blog.resultOther,
  }}
>
  const form = document.getElementById('blog-search-form');
  const input = document.getElementById('blog-search');
  const count = document.getElementById('search-count');
  const empty = document.getElementById('search-empty');
  const tagFilter = document.getElementById('tag-filter');
  const tagName = document.getElementById('tag-filter-name');
  const tagClear = document.getElementById('tag-filter-clear');
  const cards = Array.from(document.querySelectorAll('.blog-card'));

  const normalize = (value) =>
    value
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .toLowerCase();

  let activeTag = null;
  let activeTagLabel = '';
  const pluralRules = new Intl.PluralRules(locale);

  const params = new URLSearchParams(window.location.search);
  const tagParam = params.get('tag');
  if (tagParam) {
    activeTag = normalize(tagParam);
    activeTagLabel = tagParam;
  }

  function applyFilter() {
    const query = normalize(input.value.trim());
    let visible = 0;

    for (const card of cards) {
      const text = card.dataset.search || '';
      const tags = (card.dataset.tags || '').split('|').filter(Boolean);
      const matchesText = !query || text.includes(query);
      const matchesTag = !activeTag || tags.includes(activeTag);
      const show = matchesText && matchesTag;
      const item = card.closest('[data-blog-item]');
      item?.classList.toggle('hidden', !show);
      if (show) visible++;
    }

    const resultLabel = pluralRules.select(visible) === 'one' ? resultOne : resultOther;
    count.textContent = `${visible} ${resultLabel}`;
    empty.classList.toggle('hidden', visible !== 0);

    if (activeTag) {
      tagName.textContent = activeTagLabel;
      tagFilter.classList.remove('hidden');
      tagFilter.classList.add('flex');
    } else {
      tagFilter.classList.add('hidden');
      tagFilter.classList.remove('flex');
    }
  }

  form?.addEventListener('submit', (event) => event.preventDefault());
  input?.addEventListener('input', applyFilter);

  tagClear?.addEventListener('click', () => {
    activeTag = null;
    activeTagLabel = '';
    const url = new URL(window.location.href);
    url.searchParams.delete('tag');
    window.history.replaceState({}, '', url);
    applyFilter();
  });

  applyFilter();
</script>
