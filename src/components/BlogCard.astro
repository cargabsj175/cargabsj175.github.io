---
import {
  formatDate,
  getBlogPostPath,
  getReadingTime,
  getSlugFromId,
  getTagPath,
  normalizeText,
  type BlogPost,
  type Locale,
} from '../utils/blog';

interface Props {
  post: BlogPost;
  lang: Locale;
  t: Record<string, any>;
  featured?: boolean;
}

const { post, lang, t, featured = false } = Astro.props;

const slug = getSlugFromId(post.id);
const url = getBlogPostPath(lang, slug);
const readingTime = getReadingTime(post.body);
const tags = post.data.tags ?? [];
const searchText = normalizeText(
  [post.data.title, post.data.description, ...tags].join(' ')
);
const tagList = tags.map(normalizeText).join('|');
---

<article
  class:list={[
    'blog-card group flex flex-col overflow-hidden rounded-xl border border-gray-200 bg-white transition hover:border-primary/40 hover:shadow-md',
    featured && 'md:flex-row',
  ]}
  data-search={searchText}
  data-tags={tagList}
>
  {post.data.cover && (
    <a href={url} class:list={['block overflow-hidden bg-gray-100', featured ? 'md:w-2/5' : '']}>
      <img
        src={post.data.cover}
        alt={post.data.coverAlt ?? post.data.title}
        class:list={[
          'h-48 w-full object-cover transition duration-300 group-hover:scale-105',
          featured && 'md:h-full',
        ]}
        loading="lazy"
      />
    </a>
  )}

  <div class="flex flex-1 flex-col p-6">
    <h2 class:list={['font-bold text-dark', featured ? 'text-2xl md:text-3xl' : 'text-xl']}>
      <a href={url} class="hover:text-primary transition-colors">{post.data.title}</a>
    </h2>

    <p class="mt-3 flex-1 text-gray-600 leading-relaxed">{post.data.description}</p>

    <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs text-gray-500">
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time>
      <span aria-hidden="true">·</span>
      <span>{readingTime} {t.blog.readingTime}</span>
    </div>

    {tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <a
            href={getTagPath(lang, tag)}
            class="rounded-full bg-light px-2.5 py-1 text-xs font-medium text-gray-600 transition hover:bg-primary hover:text-white"
          >
            #{tag}
          </a>
        ))}
      </div>
    )}

    <a href={url} class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-primary hover:text-primary-dark">
      {t.blog.readMore}
      <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
