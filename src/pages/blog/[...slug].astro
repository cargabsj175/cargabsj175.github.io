---
import BlogLayout from '../../layouts/BlogLayout.astro';
import { en } from '../../data/translations';
import {
  getAllPosts,
  getLocaleFromId,
  getSlugFromId,
  type Locale,
} from '../../utils/blog';

const lang: Locale = 'en';

export async function getStaticPaths() {
  const allPosts = await getAllPosts();
  return allPosts
    .filter((post) => getLocaleFromId(post.id) === 'en')
    .map((post) => ({
      params: { slug: getSlugFromId(post.id) },
      props: { post },
    }));
}

const { post } = Astro.props;
const allPosts = await getAllPosts();
---

<BlogLayout post={post} lang={lang} t={en} allPosts={allPosts} />
